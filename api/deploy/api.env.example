# Install as /etc/hramatka/api.env with mode 0640 and owner root:hramatka.
# This is a name-only template.  Values belong in the host secret store or a
# root-owned file outside the checkout; never commit a populated copy.

# Persistent-volume path.  The parent directory must be writable by the
# hramatka service user and must not be inside /opt/hramatka/current.
HRAMATKA_DB_PATH=/var/lib/hramatka/hramatka.sqlite3

# Exact HTTPS origin, with no trailing slash.  It is used for strict Origin
# comparison on every browser mutation.
HRAMATKA_PILOT_ORIGIN=https://<pilot-hostname>

# Independent random deployment secret used for session-derived CSRF HMACs.
# Generate and store outside git; do not reuse an invite, session, or provider
# secret.  The API must refuse to start when this is missing or invalid.
HRAMATKA_CSRF_HMAC_KEY=<set-in-host-secret-store>

# Four provider-I/O-bound bakes are suitable for the pilot CX23 (2 vCPU / 4 GB).
# The runner clamps workers to 1..8. Keep this a single Uvicorn process; this is
# an in-process pool, not a multi-process SQLite deployment.
HRAMATKA_BAKE_WORKERS=4

# Cap all phase fan-out and pooled jobs together. Default is 8: tune only with
# provider-rate-limit evidence, never by adding Uvicorn processes.
HRAMATKA_MAX_PROVIDER_CONCURRENCY=8

# Both providers are active primary routes in round-robin order. Each one uses
# the other only after a retry-exhausted 5xx/timeout or HTTP 429.
HRAMATKA_BAKE_PROVIDERS=google-ais,openrouter

# Real-baker/provider configuration is deployment secret material. Supply the
# names required by the selected EngineLessonBaker deployment here, never the
# mock-baker flags in production.
HRAMATKA_AIS_API_KEY=<set-in-host-secret-store>
# Keep the OpenRouter key in the host secret store (or set
# HRAMATKA_GEMMA_FALLBACK_API_KEY_FILE to its root-readable secret-file path),
# never in this checkout. This primary uses google/gemma-4-31b-it on the wire.
HRAMATKA_GEMMA_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
HRAMATKA_GEMMA_FALLBACK_API_KEY=<set-in-host-secret-store>
HRAMATKA_GEMMA_FALLBACK_MODEL=google/gemma-4-31b-it
HRAMATKA_DATA_DIR=/srv/hramatka-data/<digest-pinned-release>

# The deployed authority is the manifest shipped alongside that exact mounted
# data release, never the repository's development/test fallback manifest.
HRAMATKA_DATA_MANIFEST=/srv/hramatka-data/<digest-pinned-release>/data-manifest.json
