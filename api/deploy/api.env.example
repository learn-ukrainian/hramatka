# Install as /etc/hramatka/api.env with mode 0640 and owner root:hramatka.
# This is a name-only template.  Values belong in the host secret store or a
# root-owned file outside the checkout; never commit a populated copy.

# Persistent-volume path.  The parent directory must be writable by the
# hramatka service user and must not be inside /opt/hramatka/current.
HRAMATKA_DB_PATH=/var/lib/hramatka/hramatka.sqlite3

# Exact HTTPS origin, with no trailing slash.  It is used for strict Origin
# comparison on every browser mutation.
HRAMATKA_PILOT_ORIGIN=https://<pilot-hostname>

# Independent random deployment secret used for session-derived CSRF HMACs.
# Generate and store outside git; do not reuse an invite, session, or provider
# secret.  The API must refuse to start when this is missing or invalid.
HRAMATKA_CSRF_HMAC_KEY=<set-in-host-secret-store>

# Four provider-I/O-bound bakes are suitable for the pilot CX23 (2 vCPU / 4 GB).
# The runner clamps workers to 1..8. Keep this a single Uvicorn process; this is
# an in-process pool, not a multi-process SQLite deployment.
HRAMATKA_BAKE_WORKERS=4

# Cap all phase fan-out and pooled jobs together. Default is 8: tune only with
# provider-rate-limit evidence, never by adding Uvicorn processes.
HRAMATKA_MAX_PROVIDER_CONCURRENCY=8

# The app cannot determine whether an API-provider key is free or billed. Set
# this only to acknowledge possible metered spend; without it, standard
# API-provider bake calls are refused before transport. Subscription-client
# routes are separate and do not use this acknowledgement.
HRAMATKA_ACCEPT_METERED_PROVIDER_SPEND=0

# Current logical-model bindings use Antigravity subscriptions for Flash and
# Pro, and OpenRouter for Gemma. Google-AIS remains a separate qualification
# route; do not configure a paid Vertex fallback.
HRAMATKA_BAKE_PROVIDERS=antigravity,openrouter

# Real-baker/provider configuration is deployment secret material. Supply the
# names required by the selected EngineLessonBaker deployment here, never the
# mock-baker flags in production.
HRAMATKA_AIS_API_KEY=<set-in-host-secret-store>
# Keep the OpenRouter key in the host secret store (or set
# HRAMATKA_GEMMA_FALLBACK_API_KEY_FILE to its root-readable secret-file path),
# never in this checkout. This primary uses google/gemma-4-31b-it on the wire.
HRAMATKA_GEMMA_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
HRAMATKA_GEMMA_FALLBACK_API_KEY=<set-in-host-secret-store>
HRAMATKA_GEMMA_FALLBACK_MODEL=google/gemma-4-31b-it
HRAMATKA_DATA_DIR=/srv/hramatka-data/<digest-pinned-release>

# The deployed authority is the manifest shipped alongside that exact mounted
# data release, never the repository's development/test fallback manifest.
HRAMATKA_DATA_MANIFEST=/srv/hramatka-data/<digest-pinned-release>/data-manifest.json

# GitHub Actions review-attestation endpoint. This public HTTPS surface accepts
# only a verified GitHub OIDC assertion; it is disabled unless BOTH explicit
# numeric flags below are set to literal 1 after the release and workflow have
# been reviewed. They accept only 0 (disabled) or 1 (enabled); words such as
# true and false are rejected at startup.
# The workflow keeps its endpoint in the repository variable
# HRAMATKA_REVIEW_ATTESTOR_URL. Set EXPECTED_AUDIENCE to that exact same URL,
# including its path and without a trailing slash. Never put an AIS/API key in
# Actions: the host reuses HRAMATKA_AIS_API_KEY from this root-owned file.
# HRAMATKA_REVIEW_ATTESTATION_SIGNING_KEY_FILE is deliberately set by the
# systemd unit to its private `%d` credential copy. Do not assign the root-owned
# PEM source path here: EnvironmentFile would override the safe unit value.
HRAMATKA_REVIEW_ATTESTATION_ENABLED=<0-or-1>
HRAMATKA_REVIEW_ATTESTATION_EXPECTED_AUDIENCE=<exact-public-attestation-url>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_REPOSITORY=<github-owner/repository>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_REPOSITORY_ID=<github-repository-id>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_WORKFLOW_REF=<trusted-workflow-ref>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_WORKFLOW_DIGEST=<sha256-workflow-content-digest>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_RUNNER_ID=<positive-github-runner-id>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_RUNNER_GROUP_ID=<positive-github-runner-group-id>
HRAMATKA_REVIEW_ATTESTATION_TRUSTED_RUNNER_LABEL=hramatka-attestor
HRAMATKA_REVIEW_ATTESTATION_REVIEWER_MODEL=google-ais/gemini-3.6-flash
HRAMATKA_REVIEW_ATTESTATION_PROMPT_VERSION=<review-prompt-version>
HRAMATKA_REVIEW_ATTESTATION_MAX_DIFF_BYTES=<bounded-positive-integer>
HRAMATKA_REVIEW_ATTESTATION_PROVIDER_TIMEOUT_SECONDS=<bounded-positive-integer>
HRAMATKA_REVIEW_ATTESTATION_PAID_REVIEW_ENABLED=<0-or-1>

# The public half is not an API environment value. Store only its base64 PEM in
# the non-secret GitHub repository variable named below. The private PEM never
# enters git, Actions, a repository variable, or a GitHub secret.
# HRAMATKA_REVIEW_ATTESTATION_PUBLIC_KEY_B64=<github-repository-variable-only>

# The dedicated attestation runner deliberately does not load this file. Its
# service receives only GitHub's ephemeral job credentials; the API key,
# signing PEM, database paths, and all HRAMATKA_* values stay with hramatka-api.
# The three trusted-runner values are non-secret. Set the same exact values as
# GitHub repository variables so the PR lifecycle can bind receipts to this
# runner; do not put them in GitHub Actions secrets.
