# Copy this file to the Caddy configuration only after replacing the placeholder
# hostname in the host environment.  Do not put a production hostname, API key,
# cookie secret, or private IP address in this repository.
#
# Caddy obtains and renews the certificate for the configured HTTPS host.  The
# teacher bundle and /api are deliberately served from that one origin: the API
# must not enable CORS.

{$HRAMATKA_PILOT_HOST} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}

	# This is intentionally a public HTTPS endpoint: GitHub Actions presents an
	# OIDC assertion and the API validates it. It is not browser-facing, so CORS
	# remains absent. Keep this matcher exact; neighbouring /api paths must not
	# inherit its larger request budget or its provider-call timeout.
	@review_attestation {
		method POST
		path /api/internal/review-attestations
	}
	@review_attestation_path path /api/internal/review-attestations
	handle @review_attestation {
		# Do not add a site access logger for attestation requests. Caddy does not
		# log bodies by default; log_skip also protects this route if one is added.
		log_skip
		request_body {
			max_size 64KB
		}
		header {
			Cache-Control "no-store"
			-Access-Control-Allow-Origin
			-Access-Control-Allow-Credentials
		}
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			transport http {
				dial_timeout 5s
				response_header_timeout 180s
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	# No method other than the exact POST above reaches the API handler.
	handle @review_attestation_path {
		respond "not found" 404
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			# Defense in depth: frozen browser routes never emit CORS headers.
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
		}
	}

	# Keep the canonical static application URL trailing-slash form.  Invite
	# fragments remain client-side and therefore never reach Caddy.
	handle /teacher {
		# The first positional argument to redir is a matcher. Keep it explicit:
		# without *, Caddy treats /teacher/ as that matcher rather than the target.
		redir * /teacher/ permanent
	}

	# handle_path strips /teacher before resolving static files. The bundle is
	# beneath current so one release-symlink flip activates API and UI together.
	# An unknown teacher route falls back to the SPA entry point, while assets
	# resolve as normal files beneath the deployed teacher bundle.
	handle_path /teacher/* {
		root * /opt/hramatka/current/hramatka/app/dist
		try_files {path} /index.html
		file_server
	}

	respond "not found" 404
}
