{
  "name": "hramatka-teacher-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-activity-validator.mjs",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run && npm run build && node scripts/csp-guard.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real-backend.config.ts",
    "test:e2e:real:empty": "playwright test -c playwright.real-backend-empty.config.ts",
    "stub": "node dev/server.js"
  },
  "dependencies": {
    "@learn-ukrainian/activity-kit": "file:../vendor/activity-kit/learn-ukrainian-activity-kit-0.1.0-ffd54054.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "8.18.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "oxlint": "^0.15.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
