# Allow install scripts only for packages actually present in the dependency tree.
# This is the mitigation for the 2026-08-04 npm worm: targeted, recorded allowances, never a blanket bypass.
#
# fsevents is the macOS file-watcher native binding used by the dev server.
#
# esbuild is deliberately NOT listed. Vite 8 builds with rolldown, so esbuild is absent from the
# tree; allowing a package that is not installed is a dormant grant that would let install scripts
# run without an ESTRICTALLOWSCRIPTS prompt if esbuild ever re-entered the tree, directly or
# transitively. Add it back only together with a deliberate decision to depend on it again.
allow-scripts[]=fsevents
strict-allow-scripts=true
