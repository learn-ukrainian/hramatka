[Unit]
Description=Hramatka teacher-pilot FastAPI service
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=hramatka
Group=hramatka
UMask=0077
WorkingDirectory=/opt/hramatka/current
EnvironmentFile=/etc/hramatka/api.env
Environment=PYTHONUNBUFFERED=1

# The source PEM is root:root 0600. systemd exposes a private read-only copy to
# this unprivileged unit; the application never receives the root-owned source
# path and the private key never belongs in EnvironmentFile or process args.
LoadCredential=review-attestation-signing-key.pem:/etc/hramatka/review-attestation-signing-key.pem
Environment=HRAMATKA_REVIEW_ATTESTATION_SIGNING_KEY_FILE=%d/review-attestation-signing-key.pem

# The pilot owns its runner in-process.  --workers 1 is mandatory: multiple
# Uvicorn workers would each run a baker and violate the frozen durability
# contract.  Caddy is the only public listener; Uvicorn stays loopback-only.
ExecStart=/opt/hramatka/current/.venv/bin/uvicorn hramatka.api.app:create_app --factory --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s

# SQLite state, WAL files, and the application-owned runtime directory must be
# on the persistent volume, never beneath a release checkout.
StateDirectory=hramatka
StateDirectoryMode=0750
ReadWritePaths=/var/lib/hramatka
ReadOnlyPaths=/opt/hramatka/current

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
