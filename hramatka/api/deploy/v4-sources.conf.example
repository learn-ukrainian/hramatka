# Staged drop-in for the EXISTING learn-ukrainian-sources.service, an ACTIVE
# per-user unit of the operator account (fragment under that account's
# ~/.config/systemd/user; install this file in
# ~/.config/systemd/user/learn-ukrainian-sources.service.d/). No new OS
# identity, no rehome: the unit keeps its checkout, corpus and resources, and
# the principal is the per-user manager's owner (never root, never the API
# account). User=/Group= are not applicable to a per-user unit.
[Service]
UMask=0077
Environment=HRAMATKA_V4_EXECUTION_ENABLED=0
Environment=HRAMATKA_V4_ADMISSION_ENABLED=0
Environment=PYTHONDONTWRITEBYTECODE=1
# Select the verified pinned runtime for the ACTUAL full Sources server
# (.mcp/servers/sources/server.py under the project interpreter, Python 3.12)
# and for the in-unit canary alike: a root-owned immutable `pip install
# --no-deps --no-compile --target` directory holding ONLY the vendored
# pure-Python wheel of the current private pin, no dependencies. Sources keeps
# its own interpreter and MCP/psycopg/starlette environment; never place a
# Python 3.14 release venv's site-packages here. Substitute the actual path.
Environment=PYTHONPATH=/opt/hramatka/v4-runtime/learn_ukrainian_v4_runtime@v1-1e70c1280def6caa082d56623b32ca649025d3ad
NoNewPrivileges=yes
SystemCallFilter=~@debug
# systemd exposes this as $CREDENTIALS_DIRECTORY/v4-sources-dsn under
# /run/user/<owner-uid>/credentials/learn-ukrainian-sources.service (0400,
# owned by the unit). A per-user manager loads the source as its owner, so the
# source is an owner-only 0600 file (or an encrypted `systemd-creds encrypt
# --user` credential); a root-only source cannot be loaded here.
LoadCredential=v4-sources-dsn:<owner-only-0600-sources-only-dsn-file>
# ProtectHome=/ProtectSystem=/ProtectProc=/InaccessiblePaths= are not applied:
# the unit legitimately needs its checkout under the owner's home, and
# ProtectProc=/ProcSubset= are unavailable to per-user managers. Denial of the
# API credential namespace (/run/credentials/hramatka-api.service, 0700 API
# account) and of the root-owned signing-key root is by ownership and is proven
# in-unit by the Sources canary, never assumed from this file.
# No signing keys, provider credential, control DSN or generic worker authority.
